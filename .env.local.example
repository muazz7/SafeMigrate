# Copy to .env.local and fill in. Never commit .env.local.

# --- Supabase (server-side only; the service key must never reach the client) ---
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Extraction provider: 'gemini' | 'anthropic' ---
EXTRACTION_PROVIDER=gemini
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# --- API base (BUILD-SPEC §4.1) ---
# Web build: leave EMPTY so calls resolve to relative /api/... paths.
# APK build: set to the deployed Vercel origin, e.g. https://safemigrate.vercel.app
NEXT_PUBLIC_API_BASE=

# --- Demo mode: serves four cached fixtures with no API call (BUILD-SPEC §12.3) ---
# Always 'true' in the APK build so aeroplane mode still demos.
NEXT_PUBLIC_DEMO_MODE=false

# --- CORS: origins allowed to call the API routes. The APK's WebView origin is
#     capacitor://localhost or https://localhost, NOT the Vercel domain (§4.1). ---
ALLOWED_ORIGINS=https://localhost,capacitor://localhost,http://localhost:3000
